# Copy to .env and adjust. Nothing in here is secret — alerting credentials
# live in secrets/alerting.yaml (see secrets/alerting.yaml.example).

# Public host name of the status page. Needs a public A (and AAAA, if the
# proxy listens on IPv6) record pointing at the VPS: Let's Encrypt validates
# HTTP-01 against it.
STATUS_DOMAIN=status.example.com

# Shown in the browser tab and the page header.
STATUS_TITLE=Status

# Host address + port the container is published on. Traefik (rootful daemon)
# connects here. Default: the rootful daemon's docker0 gateway. Check with
#   ip -4 -o addr show docker0
# Never 0.0.0.0 — that would expose Gatus without TLS on every interface.
GATUS_BIND=172.17.0.1
GATUS_PORT=18080

GATUS_VERSION=v5.38.0
GATUS_LOG_LEVEL=INFO
