# Copy to secrets/alerting.yaml — git-ignored, merged into the config.
#
#   cp secrets/alerting.yaml.example secrets/alerting.yaml
#   chmod 644 secrets/alerting.yaml     # read by uid 65534 inside the container;
#                                       # the 0700 home directory of `gatus` is
#                                       # what keeps other host users out.
#
# Bot token: @BotFather → /newbot. Chat id: send the bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates in a browser (not in a shell
# whose history is kept) and read message.chat.id.
#
# Other providers (email, ntfy, Discord, Matrix, …) go here the same way:
# https://github.com/TwiN/gatus#alerting

alerting:
  telegram:
    token: "123456:REPLACE_ME"
    id: "REPLACE_ME"
    default-alert:
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true
      description: "health check failed"
